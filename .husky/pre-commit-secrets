#!/usr/bin/env sh
# SEC-106: Pre-commit secrets scan using gitleaks
# Install gitleaks: https://github.com/gitleaks/gitleaks
# Then: cp .husky/pre-commit-secrets .husky/pre-commit (or add to existing pre-commit)
if command -v gitleaks &> /dev/null; then
  echo "🔒 Scanning for secrets..."
  gitleaks protect --staged --redact --quiet
  if [ $? -ne 0 ]; then
    echo "❌ Potential secrets detected! Review the output above before committing."
    exit 1
  fi
  echo "✅ No secrets detected"
else
  echo "⚠️  gitleaks not installed — skipping secrets scan"
  echo "   Install: https://github.com/gitleaks/gitleaks#installing"
fi