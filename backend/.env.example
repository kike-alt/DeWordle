# Server
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=dewordledb_owner
DB_PASSWORD=password
DB_NAME=dewordledb
DB_SSL=false

# Auth
JWT_SECRET=replace-with-strong-secret
FRONTEND_URL=http://localhost:3000

# Email (SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@dewordle.com

# Scheduling
DAILY_WORD_TIMEZONE=UTC
DAILY_WORD_SCHEDULE=0 0 * * *

# Third-party APIs
MW_API_KEY=
OXFORD_APP_ID=
OXFORD_APP_KEY=

# Soroban/Stellar
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK=testnet
SOROBAN_CORE_GAME_CONTRACT_ID=

# Indexer
INDEXER_MAX_PAYLOAD_BYTES=8192
