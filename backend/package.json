{
  "name": "backend",
  "version": "0.0.1",
  "description": "DeWordle backend API",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "node ./node_modules/eslint/bin/eslint.js \"{src,apps,libs,test}/**/*.ts\"",
    "lint:ci": "node ./node_modules/eslint/bin/eslint.js \"src/indexer/**/*.ts\" --ignore-pattern \"**/*.spec.ts\"",
    "lint:fix": "node ./node_modules/eslint/bin/eslint.js \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "npx jest --watchman=false --runInBand src/indexer --testPathIgnorePatterns=indexer-worker.soak.spec.ts",
    "test:watch": "jest --watch",
    "test:nowatchman": "ts-node scripts/jest-no-watchman.ts",
    "test:watchman-free": "npm run test:nowatchman",
    "test:cov": "jest --coverage",
    "test:cov:nowatchman": "ts-node scripts/jest-no-watchman.ts --coverage",
    "test:cov:watchman-free": "npm run test:cov:nowatchman",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:smoke": "jest --testPathPattern=legacy-debt.smoke",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs",
    "typeorm:migration:generate": "npm run typeorm -- migration:generate -d src/data-source.ts",
    "typeorm:migration:run": "npm run typeorm -- migration:run -d src/data-source.ts",
    "typeorm:migration:revert": "npm run typeorm -- migration:revert -d src/data-source.ts",
    "seed:words": "ts-node scripts/seed-words.ts",
    "seed:words:force": "ts-node scripts/seed-words.ts --force",
    "db:setup": "npm run typeorm:migration:run && npm run seed:words"
  },
  "dependencies": {
    "@nestjs/bull": "^11.0.0",
    "@nestjs/cache-manager": "^3.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.0",
    "cache-manager": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "date-fns": "^4.1.0",
    "moment-timezone": "^0.6.0",
    "nodemailer": "^9.0.1",
    "opossum": "^9.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.29",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/bcrypt": "^5.0.2",
    "@types/bull": "^4.10.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/moment-timezone": "^0.5.13",
    "@types/node": "^22.10.7",
    "@types/opossum": "^8.1.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
