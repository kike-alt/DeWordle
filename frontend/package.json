    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dicebear": "^9.2.4",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.533.0",
    "next": "15.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
